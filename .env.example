# Copy to .env for local runs. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# App user (data only, row-level security applies) and migration user (owns the schema).
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/school_erp
DATABASE_MIGRATION_URL=postgres://erp_migrator:erp_migrator@localhost:5432/school_erp

# Comma-separated browser origins allowed to call the API (the Super Admin console).
CORS_ORIGINS=http://localhost:3001

# memory | log | smtp. Mailpit from docker-compose catches smtp mail locally.
EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=BravyNix School ERP <no-reply@bravynix.local>

# Optional: force old mobile apps to update (426 APP_UPDATE_REQUIRED).
# MIN_APP_VERSION_ANDROID=1.0.0
# MIN_APP_VERSION_IOS=1.0.0
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.bravynix.schoolerp
# APP_STORE_URL=https://apps.apple.com/app/id0000000000

# Optional in development: a random key is made at start, so enrolled authenticators and
# sign-in secrets do not survive a restart. Staging and production require
# OTP_HMAC_SECRET (32+ characters), JWT_SIGNING_KEY (ES256 PEM) and MFA_ENCRYPTION_KEY
# (32 random bytes, base64: `openssl rand -base64 32`) from Secrets Manager.
# MFA_ENCRYPTION_KEY=

# Uploads (photos, documents, CSV imports) go to the server's own disk in development: `local`.
# Staging and production refuse it. A phone cannot reach http://localhost, so with a real phone
# set the base URL to the laptop's address (the same host as API_BASE_URL in the app's config).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
# STORAGE_LOCAL_BASE_URL=http://<laptop-ip>:3000

# Aadhaar numbers (staff and students) are encrypted with IDENTITY_ENCRYPTION_KEY and found again
# by IDENTITY_HMAC_KEY: 32 random bytes each, base64, different from each other
# (`openssl rand -base64 32`). Never random at start: a number sealed with a lost key cannot be read.
# The values below are for development only; staging and production take theirs from Secrets Manager.
IDENTITY_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleSE=
IDENTITY_HMAC_KEY=ZGV2ZWxvcG1lbnQtb25seS1obWFjLWtleS0xMjM0NSE=

OPENAPI_UI=true
