# The demo environment (project files: docs/DEMO.md). Local defaults only: the same development accounts as
# .env.example, a database of its own, and no real mail (Mailpit catches it). Never use this file anywhere shared.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/school_erp_demo
DATABASE_MIGRATION_URL=postgres://erp_migrator:erp_migrator@localhost:5432/school_erp_demo

# The console in development runs on port 3001.
CORS_ORIGINS=http://localhost:3001

EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=BravyNix School ERP <no-reply@bravynix.local>

# Sign-in codes arrive as email, so the demo reads them in Mailpit: http://localhost:8025 (docker compose up -d).
# Uploads (photos, documents, CSV imports) go to the server's own disk in development: `local`.
# Staging and production refuse it. A phone cannot reach http://localhost, so with a real phone
# set the base URL to the laptop's address (the same host as API_BASE_URL in the app's config).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
# STORAGE_LOCAL_BASE_URL=http://<laptop-ip>:3000

OPENAPI_UI=true
