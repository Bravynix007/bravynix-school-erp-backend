{
  "name": "bravynix-school-erp-backend",
  "version": "0.1.0",
  "description": "BravyNix School ERP API and worker (NestJS, PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src/ test/",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --config ./vitest.config.cov.ts --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "db:migrate": "tsx src/cli/migrate.ts latest",
    "db:migrate:down": "tsx src/cli/migrate.ts down",
    "db:seed": "tsx src/cli/seed.ts",
    "openapi": "nest build && node dist/cli/openapi.js",
    "policies": "nest build && node dist/cli/policies.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.7",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
